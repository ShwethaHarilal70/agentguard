# .env.example

# ──────────────────────────────────────────────────────────────
# AgentGuard Configuration
# Copy this file to .env and fill in your credentials
# ──────────────────────────────────────────────────────────────

# Claude Haiku API (for governance explanations)
# Get key from: https://console.anthropic.com/account/keys
CLAUDE_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY_HERE

# Jira REST API Configuration
# Instructions: https://support.atlassian.com/atlassian-account/docs/manage-api-tokens-for-your-atlassian-account/
JIRA_URL=https://your-instance.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token_here

# (Optional) Lobster Trap threat detection
# Only needed if you've built Lobster Trap executable
LOBSTER_TRAP_PATH=./lobstertrap.exe
